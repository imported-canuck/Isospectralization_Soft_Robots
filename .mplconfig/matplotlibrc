figure.figsize: 3.5, 2.16
figure.dpi: 600

xtick.direction: in
ytick.direction: in
xtick.top: True
ytick.right: True
xtick.major.size: 3
ytick.major.size: 3
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.minor.visible: True
ytick.minor.visible: True
xtick.minor.size: 2
ytick.minor.size: 2
xtick.minor.width: 0.5
ytick.minor.width: 0.5

axes.linewidth: 0.5
grid.linewidth: 0.5
lines.linewidth: 1.0
lines.markersize: 3

legend.frameon: False
savefig.bbox: tight
savefig.pad_inches: 0.05

font.family: serif
font.size: 8
text.usetex: True
text.latex.preamble: \usepackage{amsmath} \usepackage{amssymb}